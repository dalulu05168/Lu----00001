# Development only; do not commit actual secrets
DATABASE_URL=postgres://app_user:replace_me@localhost:5432/global_stock_platform
PORT=3001
# Configure TLS and trusted CA for production databases.
# Optional: free Finnhub API key enables real-time US stock quotes used for
# simulated buy/sell, the simulated /api/orders endpoint, and live holding
# valuation. https://finnhub.io (no card). Without it, those stay unavailable.
FINNHUB_API_KEY=
# Optional: free Twelve Data API key enables the admin stock-history chart
# (90-day daily closes) and the existing stock-lookup symbol search already
# uses the same key. https://twelvedata.com (no card). Without it, history
# stays unavailable; symbol search still works with local/catalog results.
TWELVE_DATA_API_KEY=
