# Development only; do not commit actual secrets
DATABASE_URL=postgres://app_user:replace_me@localhost:5432/global_stock_platform
PORT=3001
# Configure TLS and trusted CA for production databases.

# Market data: use Finnhub first when configured; Alpha Vantage is fallback/display-only.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_ENTITLEMENT=delayed
# Keep false until the provider entitlement and quote freshness are verified.
MARKET_DATA_EXECUTION_ENABLED=false
