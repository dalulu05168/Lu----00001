# Development only; do not commit actual secrets
DATABASE_URL=postgres://app_user:replace_me@localhost:5432/global_stock_platform
PORT=3001
# Configure TLS and trusted CA for production databases.
# Optional: free Alpaca Market Data (IEX feed) keys enable real-time US stock
# quotes used for simulated buy/sell and live holding valuation. Get the
# "Market Data" key pair, not a brokerage/trading account, from
# https://alpaca.markets (no card for the data-only free plan).
# Without them, US stock quotes and live holding value are simply unavailable.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
