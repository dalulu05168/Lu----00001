# Verified production HTTPS API origin; must match the deployed customer account backend.
EXPO_PUBLIC_API_BASE_URL=https://api.example
# Public privacy policy approved by actual operating entity; accessible before login.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://privacy.example/policy

# The following release attestations are intentionally NOT given default values.
# Set them only after independently verifying documentary evidence for each item.
# Release verification also checks public /ready and /account-deletion pages.
# RELEASE_SUPPORT_URL=https://support.example
# RELEASE_LEGAL_ENTITY=Verified legal business name
# RELEASE_ALLOWED_COUNTRIES=Approved country codes
# RELEASE_IOS_STORE_ACCOUNT_VERIFIED=true
# RELEASE_ANDROID_STORE_ACCOUNT_VERIFIED=true
# RELEASE_APP_IDS_APPROVED=true
# RELEASE_FINANCIAL_LEGAL_REVIEW=true
# RELEASE_DATA_RETENTION_APPROVED=true
# RELEASE_DELETION_PROCESS_OPERATIONAL=true
# RELEASE_PRIVACY_DISCLOSURES_APPROVED=true
# RELEASE_REVIEW_ACCOUNT_READY=true
# RELEASE_DEVICE_TESTS_PASSED=true
