{
  "expo": {
    "name": "NuvexaPro",
    "slug": "nuvexapro-client",
    "scheme": "nuvexapro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nuvexapro.globalstock",
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.nuvexapro.globalstock",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111722"
      }
    },
    "updates": {
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "serviceDescription": "Internal account records only; not a broker or live trading app"
    },
    "icon": "./assets/icon.png",
    "experiments": {
      "baseUrl": "/global-stock-platform"
    }
  }
}
