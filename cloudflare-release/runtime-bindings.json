      "type": "secret_text",
      "name": "ADMIN_BOOTSTRAP_SECRET"
    },
    {
      "type": "secret_text",
      "name": "ADMIN_MASTER_EMAIL"
    },
    {
      "type": "secret_text",
      "name": "ADMIN_TOTP_ENCRYPTION_KEY"
    },
    {
      "type": "assets",
      "name": "ASSETS"
    },
    {
      "type": "secret_text",
      "name": "CN_PROFILE_ENCRYPTION_KEY"
    },
    {
      "type": "plain_text",
      "name": "COMMODITY_REFERENCE_EXECUTION_ENABLED"
    },
    {
      "type": "secret_text",
      "name": "DATABASE_URL"
    },
    {
      "type": "secret_text",
      "name": "EULERPOOL_API_KEY"
    },
    {
      "type": "plain_text",
      "name": "PGSSL"
