{
  "name": "lu----00001",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PGSSL": "require",
    "COMMODITY_REFERENCE_EXECUTION_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
