# CN Capital / NuvexaPro production environment template
# Copy this file into the deployment platform's environment-variable panel.
# Never commit the filled-in version and never put real secrets in Git.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Use the private/internal connection string supplied by the hosting provider.
# Required by src/server.mjs.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Optional: use the provider's non-pooled/direct connection for migrations.
# If not needed, leave empty or omit it.
DATABASE_URL_UNPOOLED=postgresql://DB_USER:DB_PASSWORD@DB_DIRECT_HOST:5432/DB_NAME

# Require TLS for production PostgreSQL.
PGSSL=require

# -----------------------------------------------------------------------------
# Market data provider
# -----------------------------------------------------------------------------
# Recommended first provider for US stock quotes.
# Obtain the value from the Finnhub dashboard.
FINNHUB_API_KEY=replace_with_real_finnhub_api_key

# Optional fallback/display provider. Do not expose this key in browser code.
ALPHA_VANTAGE_API_KEY=replace_with_real_alpha_vantage_api_key

# Alpha Vantage quote freshness mode. Free access is normally delayed or EOD.
# Allowed project values: delayed or realtime.
ALPHA_VANTAGE_ENTITLEMENT=delayed

# -----------------------------------------------------------------------------
# Trading safety switch
# -----------------------------------------------------------------------------
# Keep false during QA. The API can read quotes, but order execution remains
# blocked until quote entitlement, freshness and accounting checks are verified.
MARKET_DATA_EXECUTION_ENABLED=false

# -----------------------------------------------------------------------------
# Optional deployment notes
# -----------------------------------------------------------------------------
# Bind the service to 0.0.0.0 in the start command/runtime. The application
# already does this in src/server.mjs; PORT must be supplied by the host.
# Suggested start command: npm run dev:api
# Suggested migration command: npm run migrate
